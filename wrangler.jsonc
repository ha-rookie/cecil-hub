{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cecil-hub",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": true,
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "cecil_hub_events"
    }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
